# Copy to `.env` for local `supabase functions serve`. Do NOT commit `.env`.
# In production these are set via `supabase secrets set ...` instead.

# elevenlabs | openai
TTS_PROVIDER=elevenlabs

# set the key for the provider you chose
ELEVENLABS_API_KEY=
OPENAI_API_KEY=

# optional: restrict which site may call the function (default *)
CORS_ORIGIN=*
